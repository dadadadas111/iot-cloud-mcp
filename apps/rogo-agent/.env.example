# ─── Rogo MCP backend (required) ───────────────────────────────────────────────
ROGO_MCP_URL=https://your-alias.mcp.dash.id.vn
ROGO_EMAIL=your@email.com
ROGO_PASSWORD=yourpassword

# ─── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=https://agent.rogo.com.vn   # used to build OTA websocket_url for devices

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL=3600

# ─── STT ────────────────────────────────────────────────────────────────────────
# Options: openai | funasr (self-hosted)
STT_PROVIDER=openai

# OpenAI Whisper
# STT_BASE_URL=https://api.openai.com/v1   # default, can be omitted
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1

# Groq Whisper (faster, cheaper)
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=gsk_...
STT_MODEL=whisper-large-v3-turbo

# FunASR / local Whisper server
# STT_PROVIDER=funasr
# FUNASR_URL=http://localhost:10095

# Fallback key (used if STT_API_KEY / LLM_API_KEY not set)
OPENAI_API_KEY=

# ─── LLM ────────────────────────────────────────────────────────────────────────
# Options: openai (default) | openai_compatible | anthropic | ollama

# OpenAI
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY is shared with STT above

# Any OpenAI-compatible endpoint (vLLM, LM Studio, Groq, TogetherAI, local, etc.)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-llm-server.example.com/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=your-model-name

# Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434

# ─── TTS ────────────────────────────────────────────────────────────────────────
# Options: edge_tts (default, zero infra, Vietnamese support) | fish_speech (self-hosted)
TTS_PROVIDER=edge_tts
TTS_VOICE=vi-VN-HoaiMyNeural         # Vietnamese female voice

# ─── Wakeword ───────────────────────────────────────────────────────────────────
WAKEWORD_MODEL=hey_rogo              # path to custom .onnx model or openwakeword built-in name
WAKEWORD_THRESHOLD=0.5

# ─── Audio ──────────────────────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=30
SILENCE_TIMEOUT_MS=1500

# ─── Firmware / Xiaozhi compat ────────────────────────────────────────────────────
# FIRMWARE_PROTOCOL: "xiaozhi" = stock firmware (use /xiaozhi/ws) | "rogo" = patched firmware
FIRMWARE_PROTOCOL=xiaozhi
# XIAOZHI_AUDIO_FORMAT: "opus" (default, what stock firmware sends) | "pcm" (raw PCM16)
XIAOZHI_AUDIO_FORMAT=opus
