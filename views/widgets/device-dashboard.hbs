<div id="device-dashboard-widget">
  <style>
    #device-dashboard-widget {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      max-width: 560px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      overflow: hidden;
      color: #1a1a1a;
    }

    .ddw-header {
      padding: 20px 24px 16px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .ddw-title-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }

    .ddw-device-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #f0f4ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .ddw-title-text {
      flex: 1;
      min-width: 0;
    }

    .ddw-label {
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ddw-desc {
      font-size: 13px;
      color: rgba(0, 0, 0, 0.5);
      margin: 2px 0 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ddw-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      background: #e8f5e9;
      color: #2e7d32;
      flex-shrink: 0;
    }

    .ddw-body {
      padding: 16px 24px 20px;
    }

    .ddw-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }

    .ddw-info-item {
      padding: 10px 12px;
      background: #f8f9fa;
      border-radius: 10px;
    }

    .ddw-info-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: rgba(0, 0, 0, 0.4);
      margin: 0 0 4px;
    }

    .ddw-info-value {
      font-size: 13px;
      font-weight: 500;
      color: #1a1a1a;
      margin: 0;
      word-break: break-all;
    }

    .ddw-info-item.full-width {
      grid-column: 1 / -1;
    }

    .ddw-elements-section {
      padding: 12px;
      background: #f8f9fa;
      border-radius: 10px;
      margin-bottom: 16px;
    }

    .ddw-elements-header {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: rgba(0, 0, 0, 0.4);
      margin: 0 0 8px;
    }

    .ddw-elements-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .ddw-element-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      height: 28px;
      padding: 0 10px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      color: #4a5568;
    }

    .ddw-footer {
      padding: 12px 24px;
      background: #f8f9fa;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .ddw-footer-text {
      font-size: 11px;
      color: rgba(0, 0, 0, 0.35);
      margin: 0;
    }

    .ddw-footer-brand {
      font-size: 11px;
      font-weight: 600;
      color: rgba(0, 0, 0, 0.5);
    }

    @media (max-width: 480px) {
      .ddw-info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="ddw-header">
    <div class="ddw-title-row">
      <div class="ddw-device-icon">
        {{#if deviceType}}
          {{#ifEquals deviceType "LED Light"}}💡{{/ifEquals}}
          {{#ifEquals deviceType "Switch"}}🔘{{/ifEquals}}
          {{#ifEquals deviceType "AC"}}❄️{{/ifEquals}}
          {{#ifEquals deviceType "Lock"}}🔒{{/ifEquals}}
          {{#ifEquals deviceType "Gate"}}🚪{{/ifEquals}}
          {{#ifEquals deviceType "Fan"}}🌀{{/ifEquals}}
          {{#ifEquals deviceType "Sensor"}}📡{{/ifEquals}}
          {{#ifEquals deviceType "Curtain"}}🪟{{/ifEquals}}
        {{else}}
          📟
        {{/if}}
      </div>
      <div class="ddw-title-text">
        <h2 class="ddw-label">{{#if label}}{{label}}{{else}}Unnamed Device{{/if}}</h2>
        {{#if desc}}<p class="ddw-desc">{{desc}}</p>{{/if}}
      </div>
      {{#if deviceType}}
        <span class="ddw-badge">{{deviceType}}</span>
      {{/if}}
    </div>
  </div>

  <div class="ddw-body">
    <div class="ddw-info-grid">
      {{#if uuid}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">UUID</p>
        <p class="ddw-info-value">{{uuid}}</p>
      </div>
      {{/if}}

      {{#if mac}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">MAC Address</p>
        <p class="ddw-info-value">{{mac}}</p>
      </div>
      {{/if}}

      {{#if brand}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">Brand</p>
        <p class="ddw-info-value">{{brand}}</p>
      </div>
      {{/if}}

      {{#if ownership}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">Ownership</p>
        <p class="ddw-info-value">{{ownership}}</p>
      </div>
      {{/if}}

      {{#if locationId}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">Location ID</p>
        <p class="ddw-info-value">{{locationId}}</p>
      </div>
      {{/if}}

      {{#if groupId}}
      <div class="ddw-info-item">
        <p class="ddw-info-label">Group ID</p>
        <p class="ddw-info-value">{{groupId}}</p>
      </div>
      {{/if}}

      {{#if productId}}
      <div class="ddw-info-item full-width">
        <p class="ddw-info-label">Product ID</p>
        <p class="ddw-info-value">{{productId}}</p>
      </div>
      {{/if}}
    </div>

    {{#if elementIds}}
    <div class="ddw-elements-section">
      <p class="ddw-elements-header">Element IDs ({{elementIds.length}})</p>
      <div class="ddw-elements-list">
        {{#each elementIds}}
          <span class="ddw-element-chip">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>

  <div class="ddw-footer">
    <p class="ddw-footer-text">Rogo IoT Cloud</p>
    {{#if brand}}
      <span class="ddw-footer-brand">{{brand}}</span>
    {{/if}}
  </div>
</div>
